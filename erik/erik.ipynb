   "id": "7602dd07",
   "metadata": {},
   "source": [
    "##### violin plot"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d4ba9df2",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
