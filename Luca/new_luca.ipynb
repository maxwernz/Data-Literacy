    "\n",
    "    ax.xaxis.set_major_locator(mtick.MultipleLocator(1))\n",
    "    \n",
    "    ax.set_ylabel('Relative Perfomance Change (\\\\%)')\n",
    "    ax.grid(True, linestyle=':', alpha=0.3)\n",
    "\n",
    "    # Legende\n",
    "    ax.legend(title='Discipline category', ncols=2)\n",
    "\n",
    "    plt.show()"
   ]
